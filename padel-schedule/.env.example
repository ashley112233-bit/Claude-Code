# Padel Schedule — environment configuration
# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# --- Google OAuth credentials (required) ---------------------------------
# Create these in Google Cloud Console → APIs & Services → Credentials →
# "OAuth client ID" → Application type: "Web application".
# Add this Authorized redirect URI:  http://localhost:3000/oauth2callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match one of the Authorized redirect URIs above.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# --- Optional -------------------------------------------------------------
# Which calendar to read. "primary" is your main Google Calendar.
GOOGLE_CALENDAR_ID=primary

# How many days ahead to show matches.
LOOKAHEAD_DAYS=30

# Port the local server listens on.
PORT=3000

# Where the sign-in token is cached (relative to the project folder).
TOKEN_FILE=token.json
