# Padel Schedule — configuration
# Copy this file to .env and paste in your calendar link:
#   cp .env.example .env

# --- Your Google Calendar's private iCal link (required) -----------------
# In Google Calendar (on a computer):
#   Settings  ->  click your calendar under "Settings for my calendars"
#   ->  "Integrate calendar"  ->  copy "Secret address in iCal format".
# It looks like:
#   https://calendar.google.com/calendar/ical/xxxxx%40group.calendar.google.com/private-xxxx/basic.ics
# Keep it private — anyone with this link can read that calendar.
CALENDAR_ICS_URL=

# --- Optional -------------------------------------------------------------
# How many days ahead to show matches.
LOOKAHEAD_DAYS=30

# Port the local server listens on.
PORT=3000
